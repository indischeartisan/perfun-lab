PAYMENT_PROVIDER=doku
PAYMENT_ENVIRONMENT=sandbox
DOKU_CLIENT_ID=your_sandbox_client_id
DOKU_SECRET_KEY=your_sandbox_secret_key
APP_URL=http://localhost:5173/
DOKU_NOTIFICATION_URL=https://fcightecxkegtqlaxvjs.supabase.co/functions/v1/payments-webhook
PAYMENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RajaOngkir Shipping Cost only. Keep disabled/unset until its sandbox environment is confirmed.
SHIPPING_ENVIRONMENT=sandbox
RAJAONGKIR_SHIPPING_COST_BASE_URL=https://rajaongkir.komerce.id/api/v1/
RAJAONGKIR_SHIPPING_COST_API_KEY=your_shipping_cost_sandbox_key
SHIPPING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provisioned by Supabase Edge runtime.
# Never put the variables above in VITE_ env variables.
